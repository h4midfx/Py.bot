# کپی در Railway: تب Variables ← Raw Editor. کامنت‌ها را در خط جدا نگه دارید (کنار مقدار ننویسید).

# --- الزامی ---
BOT_TOKEN=123456:REPLACE_WITH_TOKEN_FROM_BOTFATHER
# آیدی عددی ادمین(ها)، با کاما جدا کنید
ADMIN_IDS=111111111

# --- پلن‌ها: شناسه:روز:Stars ---
# برای تست اولیه از test:1:1 استفاده کنید و بعد از تست پرداخت، قیمت واقعی بگذارید
PLANS=week:7:150,month:30:500,quarter:90:1200

# --- منبع داده‌ی بازار: binance یا bybit ---
# اگر بایننس خطای 451/403 داد (معمولاً IP آمریکا)، ریجن را عوض کنید یا bybit بگذارید
EXCHANGE=binance
TIMEFRAME=15m
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,SUIUSDT

# --- سیگنال ---
# 1 تا 4؛ بالاتر = سیگنال کمتر و گزینش‌شده‌تر
MIN_SCORE=2
# مدیریت حد ضرر بعد از لمس هدف:
#   fixed = ثابت | be = بعد از TP1 به ورود | trail = متحرک (ورود، سپس TP1، TP2 ...)
# قبل از تغییر با «python backtest.py ALL 90 --stop trail» مقایسه کنید
STOP_MODE=fixed
# کارمزد هر سمت (0.0004 = 0.04%) و حداکثر سهم کارمزد از R برای پذیرش سیگنال (0 = بدون فیلتر؛ پیشنهاد آزمایشی 0.15)
FEE_RATE=0.0004
MAX_FEE_R=0
SCAN_EVERY=300
MAX_HOLD_CANDLES=150
# فیلتر تایم‌فریم بالاتر: سیگنال خلاف روند آن حذف می‌شود (باید بزرگ‌تر از TIMEFRAME و مضرب آن باشد؛ خالی = خاموش)
# حتماً اول با «python backtest.py ALL 90 --htf 1h» مقایسه کنید
HTF=
# سقف ریسک کلی: حداکثر سیگنال باز هم‌زمان و حداکثر سیگنال در ۲۴ ساعت (0 = نامحدود)
MAX_OPEN_SIGNALS=8
MAX_SIGNALS_PER_DAY=12
# توقف خودکار ارسال بعد از N باخت پیاپی (0 = خاموش). عدد را از «بیشترین باخت پیاپی» بک‌تست بالاتر بگذارید
PAUSE_AFTER_LOSSES=0

# --- رشد و فروش ---
# تست رایگان (روز)، 0 = خاموش
TRIAL_DAYS=1
# پاداش معرف (روز)، 0 = خاموش
REF_BONUS_DAYS=3
# یوزرنیم پشتیبانی بدون @
SUPPORT_USERNAME=
# اختیاری: کانال عمومی برای نتایج، مثلاً @mychannel (ربات باید ادمین کانال باشد)
PUBLIC_CHANNEL_ID=

# --- زیرساخت (معمولاً لازم نیست) ---
# روی Railway اگر Volume وصل کنید، DB_PATH خودکار می‌شود (RAILWAY_VOLUME_MOUNT_PATH)
# DB_PATH=/data/bot.db
# EXCHANGE_URL=
# نگهبان: اگر ربات این‌قدر ثانیه ضربان نداشت (قفل‌شدن)، پردازه بسته می‌شود تا پلتفرم دوباره راه بیندازد (0 = خاموش، حداقل 120)
WATCHDOG_SECONDS=600
HTTP_TIMEOUT=10
HTTP_RETRIES=3
CONCURRENCY=5
